* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Keep the Composer/GitHub source archive to what the plugin actually needs.
# WordPress.org releases are not affected - that deploy reads .distignore.
# Runtime folders and README.md stay in, on purpose.
/.github         export-ignore
/.wordpress-org  export-ignore
/.distignore     export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/phpcs.xml.dist  export-ignore

# Widget authoring scaffold — kept in git, shipped nowhere.
/includes/Widgets/_Template        export-ignore
/assets/css/widgets/_template.css  export-ignore
/assets/js/widgets/_template.js    export-ignore
